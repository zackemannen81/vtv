{
  "name": "vtv-client",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop prototype for vtv, built with Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.vtv.client",
    "productName": "vtv",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
